{
  "name": "chaibook-llm-backend",
  "version": "1.0.0",
  "description": "Modular RAG backend using LangChain.js, Express, Qdrant, and OpenAI for ChaiBook LLM",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test:openai": "ts-node tests/test-openai.ts",
    "test:qdrant": "ts-node tests/test-qdrant.ts",
    "test:s3": "ts-node tests/test-s3.ts",
    "test:postgres": "ts-node tests/test-postgres.ts",
    "test:redis": "ts-node tests/test-redis.ts",
    "test:all": "ts-node tests/test-all.ts",
    "test:api": "ts-node tests/api.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.614.0",
    "@aws-sdk/s3-request-presigner": "^3.614.0",
    "@langchain/community": "^0.3.0",
    "@langchain/core": "^0.3.0",
    "@langchain/openai": "^0.3.0",
    "@langchain/textsplitters": "^0.1.0",
    "@prisma/client": "^5.16.1",
    "@qdrant/js-client-rest": "^1.11.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bullmq": "^5.8.7",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^0.3.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "uuid": "^10.0.0",
    "youtube-transcript": "^1.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/pdf-parse": "^1.1.4",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.16.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  }
}
