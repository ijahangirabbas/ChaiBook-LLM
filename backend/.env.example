# ==============================================================================
# ChaiBook LLM RAG Backend — Environment Variables (.env.example)
# Configured for Render / Server Deployment
# ==============================================================================

# Server Port & Environment
PORT=3001
NODE_ENV=production

# Database (PostgreSQL / Neon / PostgreSQL URL)
DATABASE_URL="postgresql://neondb_owner:password@ep-proud-sunset-ax0w4vtk-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Clerk Authentication (From Clerk Dashboard -> API Keys)
CLERK_SECRET_KEY="sk_test_your-clerk-secret-key-here"
CLERK_PUBLISHABLE_KEY="pk_test_your-clerk-publishable-key-here"

# Automated API tests only (NODE_ENV=test) — never set in production
# TEST_JWT_SECRET="chaibook-test-jwt-secret"

# CORS Allowed Origins (comma-separated, no wildcards in production)
# Alternatively set FRONTEND_URL — it is merged into the allowlist automatically.
FRONTEND_URL=https://chaibook-llm.jahangirabbas.com
CORS_ORIGINS=https://chaibook-llm.jahangirabbas.com,http://localhost:5173

# OpenAI API Key (chat generation; also used for embeddings if JINA_API_KEY is unset)
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"
CHAT_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# Jina Embeddings (optional; preferred for embeddings when set)
JINA_API_KEY=""
JINA_EMBEDDING_MODEL="jina-embeddings-v5-text-small"
# Optional cross-encoder rerank (uses same JINA_API_KEY when set)
JINA_RERANK_MODEL="jina-reranker-v2-base-multilingual"

# Qdrant Vector Database
QDRANT_URL="https://your-qdrant-cluster-url.cloud.qdrant.io:6333"
QDRANT_API_KEY="your-qdrant-api-key-here"
QDRANT_COLLECTION_NAME="chaibook_notebook_rag"

# AWS S3 Storage (For document uploads & source files)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_S3_BUCKET_NAME="chaibook-source-documents"

# Valkey / Redis — BullMQ ingestion queue, rate limits, cache, idempotency
# Local (docker-compose Valkey):  redis://localhost:6379
# Managed Valkey with TLS:        rediss://default:PASSWORD@HOST:6379
REDIS_URL="redis://localhost:6379"

# Process role: api (API only), worker (ingestion worker only), all (dev default — both in one process)
PROCESS_ROLE=all
LOG_LEVEL=info
# Optional bearer token to protect /metrics in production
# METRICS_TOKEN=your-metrics-scraper-token
