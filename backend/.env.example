# ==============================================================================
# ChaiBook LLM RAG Backend — Environment Variables (.env.example)
# Configured for Render / Server Deployment
# ==============================================================================

# Server Port & Environment
PORT=3001
NODE_ENV=production

# Database (PostgreSQL / Neon / PostgreSQL URL)
DATABASE_URL="postgresql://neondb_owner:password@ep-proud-sunset-ax0w4vtk-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Clerk Authentication (From Clerk Dashboard -> API Keys)
CLERK_SECRET_KEY="sk_test_your-clerk-secret-key-here"
CLERK_PUBLISHABLE_KEY="pk_test_your-clerk-publishable-key-here"

# CORS Allowed Origins (Comma-separated or wildcard '*')
CORS_ORIGIN=https://chaibook-llm.jahangirabbas.com

# OpenAI API Key (For embeddings & RAG generation)
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"
CHAT_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# Qdrant Vector Database
QDRANT_URL="https://your-qdrant-cluster-url.cloud.qdrant.io:6333"
QDRANT_API_KEY="your-qdrant-api-key-here"
QDRANT_COLLECTION="chaibook_notebook_rag"

# AWS S3 Storage (For document uploads & source files)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_S3_BUCKET="chaibook-source-documents"

# Redis Cache & BullMQ Ingestion Queue (Upstash or local Redis)
REDIS_URL="rediss://default:your-redis-password@your-redis.upstash.io:6379"
