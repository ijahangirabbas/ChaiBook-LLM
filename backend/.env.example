# Database Connections
DATABASE_URL="postgresql://user:password@localhost:5432/chaibook_db?schema=public"
REDIS_URL="redis://localhost:6379"
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
CORS_ORIGINS=http://localhost:5173

# Embeddings Selection ('openai' or 'jina')
EMBEDDING_PROVIDER=jina
JINA_API_KEY=jina_...

# Qdrant Vector DB
QDRANT_URL=https://<your-qdrant-cluster>.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_key
QDRANT_COLLECTION_NAME=chaibook_sources

# AWS S3 Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your_secret
AWS_S3_BUCKET_NAME=chaibook-files
