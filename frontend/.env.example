# Live Render Backend API Base URL (Must end with /api/v1)
VITE_API_URL="https://your-backend-service.onrender.com/api/v1"

# Clerk Authentication (From Clerk Dashboard -> API Keys)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your-clerk-publishable-key-here"
