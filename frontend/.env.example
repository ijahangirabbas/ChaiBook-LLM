# ==============================================================================
# ChaiBook LLM Frontend — Environment Variables (.env.example)
# Configured for Vercel / Client Deployment
# ==============================================================================

# Live Render Backend API Base URL (Must end with /api/v1)
VITE_API_URL="https://your-backend-service.onrender.com/api/v1"

# Supabase Authentication (From Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key-here"
