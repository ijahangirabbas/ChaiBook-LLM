# Supabase Authentication Environment Variables
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend API Base URL
# Local Development: http://localhost:3001/api/v1
# Production (Render): https://your-backend.onrender.com/api/v1
VITE_API_URL=http://localhost:3001/api/v1

# Site URL for Production Deployments (Vercel, Netlify, Render, etc.)
# Local Development: http://localhost:5173
# Deployed URL Example: https://chaibook-llm.vercel.app
VITE_SITE_URL=http://localhost:5173
